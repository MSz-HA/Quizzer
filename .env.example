# Copy to .env and fill in. Only ANTHROPIC_API_KEY is required (not needed with --dev).
ANTHROPIC_API_KEY=sk-ant-...
# CLAUDE_MODEL=claude-sonnet-5-5
# QUIZ_LANGUAGE=Polish
# PORT=8000
# QUESTION_SECONDS=60
# CATEGORY_SECONDS=120
# Players pick a colour and emoji avatar; 0 = name only, colours assigned automatically
# FEATURE_AVATARS=1
# Address phones use to reach the server (shown as QR code). Required with Docker,
# otherwise the QR code points at the container's internal IP. Use the host machine's LAN IP.
# PUBLIC_URL=http://192.168.1.10:8000/
